# =====================================================
# WEDDING INVITATION SYSTEM - LOCAL CONFIGURATION
# =====================================================

PORT=3000
NODE_ENV=development
# Tùy chọn: đặt tên miền cố định cho link thiệp (để trống khi chạy local/LAN)
PUBLIC_BASE_URL=

# Database Configuration (Local: 127.0.0.1:3307, DB_SSL=false | Aiven/Cloud: DB_SSL=true + DB_SSL_CA)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=wedding
DB_PASSWORD=wedding_local_2026
DB_NAME=wedding
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=5
DB_QUEUE_LIMIT=50
DB_ACQUIRE_TIMEOUT_MS=750
DB_CONNECT_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=4000

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123123

# Session Secret Key (Bắt buộc đổi chuỗi ngẫu nhiên riêng nếu chạy production)
SESSION_SECRET=replace_with_a_long_random_secret
